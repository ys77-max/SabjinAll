# Firebase web config (Project settings → General → Your apps). Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Cloud Messaging → Web configuration)
VITE_FIREBASE_VAPID_KEY=
# App Check reCAPTCHA Enterprise site key
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Set to "true" during local dev to use the App Check debug token
VITE_APPCHECK_DEBUG=false
# Functions region
VITE_FUNCTIONS_REGION=asia-south1
